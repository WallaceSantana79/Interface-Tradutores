#!/bin/bash

# UnRen - Bash / UNIX port
# Original by Sam @ www.f95zone.to
# Ported to Bash by Gemini 3.0 Pro
# v1.0.11u(nix), feature parity with 1.0.11d + extra features

# --------------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------------
quicksavekey="K_F5"
quickloadkey="K_F9"

# --------------------------------------------------------------------------------
# Base64 encoded strings for unrpyc and rpatool
# --------------------------------------------------------------------------------

# --- unrpyc (ZIP archives) ---

# --------------------------------------------------------------------------------
# unrpyc by CensoredUsername
#   https://github.com/CensoredUsername/unrpyc
# Edited to remove multiprocessing and adjust output spacing 44febb0 2019-10-07T07:06:47.000Z
#   https://github.com/F95Sam/unrpyc
# --------------------------------------------------------------------------------
# Legacy (Old RenPy)
decompzip_legacy=""

# --------------------------------------------------------------------------------
# unrpyc by CensoredUsername 2f9810c 2022-03-31 v1.1.8 (Python 2)
#   https://github.com/CensoredUsername/unrpyc
# fried added proposed changes, as compiled by sigio, for improved Ren'Py 7.5+ compatibility
#   https://github.com/CensoredUsername/unrpyc/pull/154/files
# fried also added some resiliency when brackets are in pathnames
# --------------------------------------------------------------------------------
# Python 2 (RenPy 6(?)/7)
decompzip_py2=""

# --------------------------------------------------------------------------------
# unrpyc by madeddy with 8.4+ fixes.
#   https://github.com/madeddy/unrpyc/tree/renpy_v8.4_updates_and_corrupy
# --------------------------------------------------------------------------------
# Python 3 (RenPy 8+)
decompzip_py3=""

# --------------------------------------------------------------------------------
# rpatool by Shizmob 9a58396 2019-02-22T17:31:07.000Z
#   https://github.com/Shizmob/rpatool
# --------------------------------------------------------------------------------
# Standard rpatool (Ren'Py 7, maybe newer 6 releases?)
rpatool_py2=""

# --------------------------------------------------------------------------------
# rpatool by Shizmob 2022-08-24
#   https://github.com/Shizmob/rpatool
# --------------------------------------------------------------------------------
# Modern rpatool (RenPy 8)
rpatool_py3=""

#--------------------------------------------------------------------------------
# rpa.py by Taricorp (Peter Marheine)
#   https://www.taricorp.net/2014/reverse-engineering-renpy-packages/
# --------------------------------------------------------------------------------
# rpa.py (2014 Ren'Py, ig <=2014 ren'py 6 games may need this?) 
rpatool_extra=""


# --------------------------------------------------------------------------------
# Initialization
# --------------------------------------------------------------------------------
version="1.0.11u"
log_file="unren.log"

# Clear screen and show splash
clear
echo ""
echo "    __  __      ____               __               __ "
echo "   / / / /___  / __ \___  ____    / /_  ____ ______/ /_"
echo "  / / / / __ \/ /_/ / _ \/ __ \  / __ \/ __ \`/ ___/ __ \\"
echo " / /_/ / / / / _, _/  __/ / / / / /_/ / /_/ (__  ) / / / "
echo " \____/_/ /_/_/ |_|\___/_/ /_(_)_.___/\__,_/____/_/ /_/  v$version"
echo "  Sam @ www.f95zone.to - Bash by Gemini 3.0 Pro"
echo ""
echo " ----------------------------------------------------"
echo ""

# Check for required tools
if ! command -v unzip &> /dev/null; then
    echo "   ! Error: 'unzip' is required."
    echo "            Please install unzip (e.g., sudo apt install unzip)."
    read -n 1 -s -r -p "            Press any key to exit..."
    exit 1
fi

# --------------------------------------------------------------------------------
# Universal Path Detection
# --------------------------------------------------------------------------------
current_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Initialize variables
target_root=""
gamedir=""
maindir=""
pythondir=""
macos_bin_dir=""

# --- Step 1: Check if we are running INSIDE a game folder (Standard Linux/Windows) ---
if [[ -d "$current_script_dir/game" && -d "$current_script_dir/lib" && -d "$current_script_dir/renpy" ]]; then
    target_root="$current_script_dir"
    echo "   > Detected game files in current directory."
elif [[ -d "$current_script_dir/../game" && -d "$current_script_dir/../lib" && -d "$current_script_dir/../renpy" ]]; then
    target_root="$(dirname "$current_script_dir")"
    echo "   > Detected game files in parent directory."
fi

# --- Step 2: If not found, Prompt user to Drag & Drop ---
if [[ -z "$target_root" ]]; then
    echo "   Game files not found in the script's folder."
    echo "   Please drag and drop the Game Folder (Linux/Win) or .app (macOS) below:"
    echo ""
    read -r -p "   Path > " user_input
    echo ""

    # Sanitize input: remove surrounding quotes and expand tilde
    user_input="${user_input%\"}"
    user_input="${user_input#\"}"
    user_input="${user_input%\'}"
    user_input="${user_input#\'}"
    user_input="${user_input/#\~/$HOME}"
    user_input="${user_input%/}"

    if [[ ! -d "$user_input" ]]; then
        echo "   ! Error: Directory not found: $user_input"
        exit 1
    fi
    target_root="$user_input"
fi

echo "   > Analyzing directory structure..."

# --- Step 3: Analyze Structure (Checks both ways) ---

# A. macOS .app Detection
if [[ "$target_root" == *.app ]]; then
    echo "     Detected macOS .app bundle."
    
    # -- 1. Find Game Directory (Check Split, then Standard) --
    if [[ -d "$target_root/Contents/Resources/autorun/game" ]]; then
        gamedir="$target_root/Contents/Resources/autorun/game"
        maindir="$target_root/Contents/Resources/autorun"
        echo "     (Found Game Data in 'autorun' subfolder)"
    elif [[ -d "$target_root/Contents/Resources/game" ]]; then
        gamedir="$target_root/Contents/Resources/game"
        maindir="$target_root/Contents/Resources"
        echo "     (Found Game Data in 'Resources' subfolder)"
    else
        echo "   ! Error: Could not find 'game' folder inside .app bundle."
        echo "     Checked: Contents/Resources/autorun/game AND Contents/Resources/game"
        exit 1
    fi

    # -- 2. Find Lib Directory (Check Standard, then Autorun) --
    if [[ -d "$target_root/Contents/Resources/lib" ]]; then
        pythondir="$target_root/Contents/Resources/lib"
    elif [[ -d "$target_root/Contents/Resources/autorun/lib" ]]; then
        pythondir="$target_root/Contents/Resources/autorun/lib"
    else
        # Fallback for some weird bundles
        pythondir="$maindir/lib" 
    fi

    # -- 3. Find Binary Directory --
    if [[ -d "$target_root/Contents/MacOS" ]]; then
        macos_bin_dir="$target_root/Contents/MacOS"
    fi

# B. Standard Linux/Windows Detection
else
    if [[ -d "$target_root/game" ]]; then
        gamedir="$target_root/game"
        maindir="$target_root"
        pythondir="$target_root/lib"
    else
        echo "   ! Error: Could not find 'game' folder in $target_root"
        exit 1
    fi
fi

# Final Validation of Game Dir
if [[ ! -d "$gamedir" ]]; then
    echo "   ! Error: Critical folder 'game' missing."
    exit 1
fi

decompilerdir="$maindir/decompiler"

# Export log
log_file="$maindir/unren.log"
echo "---------------------------------" > "$log_file"
echo "new UnRen debug v$version run" >> "$log_file"
echo "Root Target: $target_root" >> "$log_file"
echo "Main Dir:    $maindir" >> "$log_file"
echo "Game Dir:    $gamedir" >> "$log_file"
echo "Lib Dir:     $pythondir" >> "$log_file"
echo "Mac Bin Dir: $macos_bin_dir" >> "$log_file"

# --------------------------------------------------------------------------------
# Python Execution Detection (Fail-over Mode)
# --------------------------------------------------------------------------------
python3="false"
python2="false"
python_exe=""
python_lib_std=""

arch=$(uname -m)
os_name=$(uname -s)

# Create a prioritized list of candidates.
# We add ALL possibilities. The loop stops at the first one found.
candidates=()

if [[ "$os_name" == "Darwin" ]]; then
    # 1. Check MacOS folder (Modern Split Apps)
    if [[ -n "$macos_bin_dir" ]]; then
        candidates+=( "$macos_bin_dir/python" )
        # Sometimes binaries have the app name, but we need the interpreter. 
        # Usually 'python' is present if embedded correctly.
    fi

    # 2. Check Lib folders (Older Standard Apps)
    # Some older RenPy Mac apps have a 'python' binary directly in Resources/lib/
    candidates+=( "$pythondir/python" ) 
    
    # 3. Check Standard RenPy Lib Structures (Deep nested)
    candidates+=( "$pythondir/py3-darwin-x86_64/python" )
    candidates+=( "$pythondir/py2-darwin-x86_64/python" )
    
    # 4. Fallback: Check parent MacOS folder if we are somehow inside the app structure
    candidates+=( "$maindir/../MacOS/python" )

elif [[ "$os_name" == "Linux" ]]; then
    if [[ "$arch" == "x86_64" ]]; then
        candidates+=( "$pythondir/py3-linux-x86_64/python" )
        candidates+=( "$pythondir/py3-linux-x86_64/python3" )
        candidates+=( "$pythondir/py2-linux-x86_64/python" )
        candidates+=( "$pythondir/linux-x86_64/python" )
    fi
    candidates+=( "$pythondir/py3-linux-i686/python" )
    candidates+=( "$pythondir/py2-linux-i686/python" )
    candidates+=( "$pythondir/linux-i686/python" )
fi

# Find Executable
for cand in "${candidates[@]}"; do
    if [[ -f "$cand" ]]; then
        python_exe="$cand"
        echo "Found Python candidate: $python_exe" >> "$log_file"
        break
    fi
done

# Deep Search Fallback (If specific paths failed)
if [[ -z "$python_exe" ]]; then
    echo "Specific paths failed, attempting deep search..." >> "$log_file"
    
    # Search MacOS dir first
    if [[ -n "$macos_bin_dir" ]]; then
         found=$(find "$macos_bin_dir" -type f -name "python" | head -n 1)
         if [[ -n "$found" ]]; then python_exe="$found"; fi
    fi
    
    # Search Lib dir second
    if [[ -z "$python_exe" && -d "$pythondir" ]]; then
        found=$(find "$pythondir" -type f \( -name "python" -o -name "python3" \) | head -n 1)
        if [[ -n "$found" ]]; then python_exe="$found"; fi
    fi
fi

# Validate and Configure
if [[ -n "$python_exe" ]]; then
    chmod u+x "$python_exe"
    
    # Version Identification
    # We check if 'python3' is in the name OR if a python3.x folder exists in lib
    if [[ "$python_exe" == *"python3"* || "$python_exe" == *"py3"* || -d "$pythondir/python3.9" || -d "$pythondir/python3.8" ]]; then
        python3="true"
        python_lib_std=$(find "$pythondir" -maxdepth 2 -type d -name "python3.*" | head -n 1)
    else
        python2="true"
        python_lib_std=$(find "$pythondir" -maxdepth 2 -type d -name "python2.*" | head -n 1)
    fi
else
    echo "   ! Error: Cannot locate embedded python executable."
    echo "     Checked locations in: $macos_bin_dir"
    echo "     And: $pythondir"
    read -n 1 -s -r -p "            Press any key to exit..."
    exit 1
fi

export PYTHONHOME="$(dirname "$python_exe")"

# macOS PYTHONHOME quirk: 
# If binary is in MacOS/, PYTHONHOME often needs to be ../Resources
if [[ "$os_name" == "Darwin" && "$python_exe" == *"/Contents/MacOS/python"* ]]; then
    export PYTHONHOME="$target_root/Contents/Resources"
fi

if [[ -n "$python_lib_std" ]]; then
    export PYTHONPATH="$python_lib_std:$maindir:$decompilerdir"
else
    export PYTHONPATH="$(dirname "$python_exe"):$maindir:$decompilerdir"
fi

echo "PYTHONPATH=$PYTHONPATH" >> "$log_file"

# --------------------------------------------------------------------------------
# Menu Function
# --------------------------------------------------------------------------------
show_menu() {
    echo "  Available Options:"
    echo "    1) Extract RPA packages"
    echo "    2) Decompile rpyc files"
    echo ""
    echo "    3) Enable Console and Developer Menu"
    echo "    4) Enable Quick Save and Quick Load"
    echo "    5) Force enable skipping of unseen content"
    echo "    6) Force enable rollback (scroll wheel)"
    echo ""
    echo "    7) Options 3-6"
    echo "    8) Options 1-6"
    echo ""
    read -p "Enter number 1-8 (or any other key to Exit): " option
    echo ""
    echo " ----------------------------------------------------"
    echo ""

    case "$option" in
        1) extract_rpa ;;
        2) decompile_rpyc ;;
        3) enable_console ;;
        4) enable_quick ;;
        5) enable_skip ;;
        6) enable_rollback ;;
        7) enable_console; enable_quick; enable_skip; enable_rollback ;;
        8) extract_rpa; decompile_rpyc; enable_console; enable_quick; enable_skip; enable_rollback ;;
        *) finish_default ;;
    esac
}

# --------------------------------------------------------------------------------
# Logic Helpers
# --------------------------------------------------------------------------------
finish_check() {
    if [[ "$option" != "8" ]]; then
        finish
    fi
}

check_chain_options() {
    if [[ "$option" == "7" || "$option" == "8" ]]; then
        return
    fi
    finish
}

finish() {
    echo " ----------------------------------------------------"
    echo ""
    echo "   Finished!"
    echo ""
    read -p "   Enter \"1\" to go back to the menu, or any other key to exit: " exitoption
    echo ""
    echo " ----------------------------------------------------"
    echo ""
    if [[ "$exitoption" == "1" ]]; then
        show_menu
    else
        finish_default
    fi
}

finish_default() {
    echo "End UnRen run" >> "$log_file"
    echo "---------------------------------" >> "$log_file"
    exit 0
}

# --------------------------------------------------------------------------------
# Option 1: Extract RPA
# --------------------------------------------------------------------------------
extract_rpa() {
    echo "Starting Extraction..." >> "$log_file"
    
    local rpa_count=$(find "$gamedir" -maxdepth 1 -name "*.rpa" | wc -l)
    if [[ "$rpa_count" -eq 0 ]]; then
        echo -e "\033[33mThere were no .rpa files to unpack under \"$gamedir\"\033[0m"
        echo ""
        finish_check
        return
    fi

    local rpatool_file="$maindir/_rpatool.py"
    local rpatool2_file="$maindir/_rpatool2.py"
    rm -f "$rpatool_file" "$rpatool2_file" "$rpatool_file.tmp" "$rpatool2_file.tmp"

    if [[ "$python3" == "true" ]]; then
        echo "$rpatool_py3" > "$rpatool_file.tmp"
    else
        echo "$rpatool_py2" > "$rpatool_file.tmp"
    fi
    echo "$rpatool_extra" > "$rpatool2_file.tmp"

    base64 -d < "$rpatool_file.tmp" > "$rpatool_file"
    base64 -d < "$rpatool2_file.tmp" > "$rpatool2_file"

    cd "$gamedir" || exit
    echo -e "\033[37;40mWorking in: \"$(pwd)\"\033[0m"

    local countunrpa=0
    local countunrpaerr=0

    for rpa in *.rpa; do
        [ -e "$rpa" ] || continue
        echo "   + Unpacking \"$rpa\""
        "$python_exe" -O "$rpatool_file" -x "$rpa" 2>/dev/null
        
        if [[ $? -ne 0 ]]; then
            "$python_exe" "$rpatool2_file" "$rpa"
            if [[ $? -ne 0 ]]; then
                ((countunrpaerr++))
                echo -e "\033[31m....... sorry, could not extract the archive.\033[0m"
            else
                ((countunrpa++))
            fi
        else
            ((countunrpa++))
        fi
    done

    if [[ "$countunrpaerr" -gt 0 ]]; then
        echo -e "\033[33mERROR: Could not unpack $countunrpaerr .rpa file(s)\033[0m"
    fi
    if [[ "$countunrpa" -gt 0 ]]; then
        echo -e "\033[33mSummary: \033[37m($countunrpa)\033[33m files newly unpacked\033[0m"
    fi
    echo ""

    rm -f "$rpatool_file" "$rpatool2_file" "$rpatool_file.tmp" "$rpatool2_file.tmp"
    cd "$maindir" || exit
    finish_check
}

# --------------------------------------------------------------------------------
# Option 2: Decompile RPYC
# --------------------------------------------------------------------------------
decompile_rpyc() {
    echo "Starting Decompile..." >> "$log_file"

    local rpyc_found=$(find "$gamedir" -name "*.rpyc" | head -n 1)
    if [[ -z "$rpyc_found" ]]; then
        echo -e "\033[33mThere were no .rpyc files to decompile under \"$gamedir\"\033[0m"
        finish_check
        return
    fi

    local decompzip="$maindir/_decomp.zip"
    local unrpycpy="$maindir/unrpyc.py"
    local deobfuscate="$maindir/deobfuscate.py"

    rm -rf "$decompilerdir" "$decompzip" "$decompzip.tmp" "$unrpycpy"

    if [[ "$python3" == "true" ]]; then
        echo "$decompzip_py3" > "$decompzip.tmp"
    elif [[ "$python2" == "true" ]]; then
        echo "$decompzip_py2" > "$decompzip.tmp"
    else
        echo "$decompzip_legacy" > "$decompzip.tmp"
    fi

    base64 -d < "$decompzip.tmp" > "$decompzip"
    echo ""
    mkdir -p "$decompilerdir"
    unzip -q -o "$decompzip" -d "$decompilerdir"
    
    if [[ -f "$decompilerdir/unrpyc.py" ]]; then
        mv "$decompilerdir/unrpyc.py" "$unrpycpy"
        mv "$decompilerdir/deobfuscate.py" "$deobfuscate" 2>/dev/null
    else
        local sub=$(find "$decompilerdir" -name "unrpyc.py" | head -n 1)
        if [[ -n "$sub" ]]; then
             mv "$(dirname "$sub")"/* "$maindir/" 2>/dev/null
        fi
    fi

    echo "  Searching for rpyc files..."
    echo ""

    local countdecomp=0
    local countdecompsuccess=0
    local countnodecomp=0
    local last_dir=""

    while IFS= read -r rpyc_file; do
        filename=$(basename "$rpyc_file")
        dirname=$(dirname "$rpyc_file")
        
        if [[ "$filename" == "un"* ]]; then continue; fi

        if [[ "$dirname" != "$last_dir" ]]; then
            last_dir="$dirname"
            echo -e "\033[37;40mWorking in: \"$dirname\"\033[0m"
        fi

        basename_no_ext="${filename%.*}"
        target_rpy="$dirname/$basename_no_ext.rpy"

        if [[ -f "$target_rpy" ]]; then
            ((countnodecomp++))
            echo "\"$filename\" already exists - skipped"
        else
            ((countdecomp++))
            
            if [[ "$python3" == "true" ]]; then
                "$python_exe" -O "$unrpycpy" "$rpyc_file"
            else
                "$python_exe" -O "$unrpycpy" --init-offset "$rpyc_file"
            fi
            
            if [[ -f "$target_rpy" ]]; then
                ((countdecompsuccess++))
            else
                echo "\"$target_rpy\" not found - probably did not decompile" >> "$log_file"
            fi
        fi
    done < <(find "$gamedir" -name "*.rpyc")

    echo ""
    # Summary
    local countdecompfailed=$((countdecomp - countdecompsuccess))
    
    echo -ne "\033[33mSummary: "
    if [[ "$countdecompsuccess" -gt 0 ]]; then
        echo -ne "\033[37m($countdecompsuccess) \033[33mfiles newly decompiled, "
    fi
    if [[ "$countdecompfailed" -gt 0 ]]; then
        echo -ne "\033[37m($countdecompfailed) \033[33mfiles failed to decompile, "
    fi
    if [[ "$countnodecomp" -gt 0 ]]; then
        echo -ne "\033[37m($countnodecomp) \033[33mdecompiled files already exist"
    fi
    echo -e "\033[0m"
    echo ""

    # Cleanup
    rm -f "$unrpycpy" "$unrpycpy"o "$decompzip" "$decompzip.tmp" "$deobfuscate" "$deobfuscate"o
    rm -rf "$decompilerdir" "$maindir/__pycache__"

    finish_check
}

# --------------------------------------------------------------------------------
# Options 3-6: Cheats
# --------------------------------------------------------------------------------

enable_console() {
    echo "  Creating Developer/Console file..."
    local consolefile="$gamedir/unren-dev.rpy"
    rm -f "$consolefile"

    cat << EOF > "$consolefile"
init 999 python:
  config.developer = True
  config.console = True
EOF

    echo "   + Console: SHIFT+O"
    echo "   + Dev Menu: SHIFT+D"
    echo ""
    check_chain_options
}

enable_quick() {
    echo "  Creating Quick Save/Quick Load file..."
    local quickfile="$gamedir/unren-quick.rpy"
    rm -f "$quickfile"

    cat << EOF > "$quickfile"
init 999 python:
  try:
    config.underlay[0].keymap['quickSave'] = QuickSave()
    config.keymap['quickSave'] = '$quicksavekey'
    config.underlay[0].keymap['quickLoad'] = QuickLoad()
    config.keymap['quickLoad'] = '$quickloadkey'
  except:
    pass
EOF

    echo "   Default hotkeys:"
    echo "   + Quick Save: F5"
    echo "   + Quick Load: F9"
    echo ""
    check_chain_options
}

enable_skip() {
    echo "  Creating skip file..."
    local skipfile="$gamedir/unren-skip.rpy"
    rm -f "$skipfile"

    cat << EOF > "$skipfile"
init 999 python:
  _preferences.skip_unseen = True
  renpy.game.preferences.skip_unseen = True
  renpy.config.allow_skipping = True
  renpy.config.fast_skipping = True
EOF

    echo "   + You can now skip all text using TAB and CTRL keys"
    echo ""
    check_chain_options
}

enable_rollback() {
    echo "  Creating rollback file..."
    local rollbackfile="$gamedir/unren-rollback.rpy"
    rm -f "$rollbackfile"

    cat << EOF > "$rollbackfile"
init 999 python:
  renpy.config.rollback_enabled = True
  renpy.config.hard_rollback_limit = 256
  renpy.config.rollback_length = 256
  def unren_noblock( *args, **kwargs ):
    return
  renpy.block_rollback = unren_noblock
  try:
    config.keymap['rollback'] = [ 'K_PAGEUP', 'repeat_K_PAGEUP', 'K_AC_BACK', 'mousedown_4' ]
  except:
    pass
EOF

    echo "   + You can now rollback using the scrollwheel"
    echo ""
    finish
}

# --------------------------------------------------------------------------------
# Main Entry Point
# --------------------------------------------------------------------------------
show_menu